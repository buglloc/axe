diff --git a/src/misc1.c b/src/misc1.c
--- a/src/misc1.c
+++ b/src/misc1.c
@@ -1791,6 +1791,46 @@ vim_version_dir(char_u *vimdir)
     return NULL;
 }
 
+#ifdef __linux__
+/* Store supplies the tree separately when the executable runs from a memfd. */
+    static char_u *
+axe_vim_dir(int runtime)
+{
+    char_u	*root = mch_getenv((char_u *)"AXE_STORE_PACKAGE_DIR");
+    char_u	executable[MAXPATHL];
+    char_u	*tail;
+    char_u	*suffix = (char_u *)(runtime
+		? "share/vim/" VIM_VERSION_NODOT : "share/vim");
+    string_T	path;
+    ssize_t	len;
+
+    if (root == NULL || *root == NUL)
+    {
+	len = readlink("/proc/self/exe", (char *)executable,
+						 sizeof(executable) - 1);
+	if (len <= 0 || (size_t)len >= sizeof(executable) - 1)
+	    return NULL;
+	executable[len] = NUL;
+	tail = gettail(executable);
+	if (tail == executable)
+	    return NULL;
+	tail[-1] = NUL;
+	tail = gettail(executable);
+	if (STRCMP(tail, "bin") != 0)
+	    return NULL;
+	*tail = NUL;
+	root = executable;
+    }
+    if (*root != '/')
+	return NULL;
+
+    concat_fnames(root, STRLEN(root), suffix, STRLEN(suffix), TRUE, &path);
+    if (path.string != NULL && !mch_isdir(path.string))
+	VIM_CLEAR(path.string);
+    return path.string;
+}
+#endif
+
 /*
  * Vim's version of getenv().
  * Special handling of $HOME, $VIM and $VIMRUNTIME.
@@ -1859,11 +1899,17 @@ vim_getenv(char_u *name, int *mustfree)
     if (!vimruntime && STRCMP(name, "VIM") != 0)
 	return NULL;
 
+#ifdef __linux__
+    p = axe_vim_dir(vimruntime);
+    if (p != NULL)
+	*mustfree = TRUE;
+#endif
+
     /*
      * When expanding $VIMRUNTIME fails, try using $VIM/vim<version> or $VIM.
      * Don't do this when default_vimruntime_dir is non-empty.
      */
-    if (vimruntime
+    if (p == NULL && vimruntime
 #ifdef HAVE_PATHDEF
 	    && *default_vimruntime_dir == NUL
 #endif
