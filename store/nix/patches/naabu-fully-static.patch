+//go:build linux
+
+package scan
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/net/ipv6"
+)
+
+func TestWriteWithConn6UsesSourceAndInterface(t *testing.T) {
+	loopback, err := net.InterfaceByName("lo")
+	require.NoError(t, err)
+
+	receiver, err := net.ListenUDP("udp6", &net.UDPAddr{IP: net.ParseIP("::1")})
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, receiver.Close())
+	})
+
+	sender, err := net.ListenUDP("udp6", &net.UDPAddr{IP: net.ParseIP("::")})
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, sender.Close())
+	})
+
+	payload := []byte("ipv6-packet-info")
+	control := &ipv6.ControlMessage{
+		Src:     net.ParseIP("::1"),
+		IfIndex: loopback.Index,
+	}
+	destination := &net.UDPAddr{IP: net.ParseIP("::1"), Port: receiver.LocalAddr().(*net.UDPAddr).Port}
+	err = writeWithConn6(ipv6.NewPacketConn(sender), payload, control, destination)
+	require.NoError(t, err)
+
+	require.NoError(t, receiver.SetReadDeadline(time.Now().Add(time.Second)))
+	buffer := make([]byte, len(payload))
+	n, source, err := receiver.ReadFromUDP(buffer)
+	require.NoError(t, err)
+	require.Equal(t, payload, buffer[:n])
+	require.True(t, source.IP.Equal(net.ParseIP("::1")))
+}
