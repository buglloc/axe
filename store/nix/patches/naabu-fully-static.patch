+func routeIPv6(listenHandler *ListenHandler, destination net.IP, zone string) (*net.Interface, net.IP, error) {
+	iface := listenHandler.NetworkInterface
+	if zone != "" {
+		var err error
+		iface, err = net.InterfaceByName(zone)
+		if err != nil {
+			return nil, nil, fmt.Errorf("interface %q: %w", zone, err)
+		}
+	}
+	if iface == nil && destination.IsLinkLocalUnicast() {
+		if PkgRouter == nil {
+			return nil, nil, errors.New("packet router is unavailable")
+		}
+		var err error
+		iface, _, _, err = PkgRouter.Route(destination)
+		if err != nil {
+			return nil, nil, err
+		}
+		if iface == nil {
+			return nil, nil, errors.New("link-local route has no network interface")
+		}
+	}
+
+	sourceIP := listenHandler.SourceIP6
+	if sourceIP == nil {
+		if iface != nil {
+			var err error
+			sourceIP, err = sourceIPv6ForInterface(iface, destination.IsLinkLocalUnicast())
+			if err != nil {
+				return nil, nil, err
+			}
+		} else {
+			sourceIP = sourceIP6For(destination)
+		}
+	}
+	if sourceIP == nil {
+		return nil, nil, errors.New("route has no IPv6 source address")
+	}
+	return iface, sourceIP, nil
+}
+
+func sourceIPv6ForInterface(iface *net.Interface, linkLocal bool) (net.IP, error) {
+	addresses, err := iface.Addrs()
+	if err != nil {
+		return nil, err
+	}
+	for _, address := range addresses {
+		ipNet, ok := address.(*net.IPNet)
+		if !ok || ipNet.IP.To4() != nil {
+			continue
+		}
+		if ipNet.IP.IsLinkLocalUnicast() == linkLocal {
+			return ipNet.IP, nil
+		}
+	}
+	return nil, fmt.Errorf("interface %s has no suitable IPv6 source address", iface.Name)
 }
 
