+func (r *Runner) resetConnectErrors() {
+	r.connectAttempts.Store(0)
+	r.connectErrors.Store(0)
+	r.connectErrorMu.Lock()
+	r.firstConnectError = nil
+	r.connectErrorMu.Unlock()
+}
+
+func (r *Runner) recordConnectResult(err error) {
+	r.connectAttempts.Add(1)
+	if err == nil || os.IsTimeout(err) || errors.Is(err, syscall.ECONNREFUSED) {
+		return
+	}
+
+	r.connectErrors.Add(1)
+	r.connectErrorMu.Lock()
+	if r.firstConnectError == nil {
+		r.firstConnectError = err
+	}
+	r.connectErrorMu.Unlock()
+}
+
+func (r *Runner) checkConnectErrors() error {
+	errorCount := r.connectErrors.Load()
+	if errorCount == 0 {
+		return nil
+	}
+	attempts := r.connectAttempts.Load()
+	r.connectErrorMu.Lock()
+	firstError := r.firstConnectError
+	r.connectErrorMu.Unlock()
+	if errorCount == attempts {
+		return fmt.Errorf("all %d connection attempts failed before ports could be scanned: %w", attempts, firstError)
+	}
+	gologger.Warning().Msgf("%d of %d connection attempts failed before ports could be scanned (first error: %s)\n", errorCount, attempts, firstError)
+	return nil
+}
+
+func (r *Runner) checkRawWriteErrors(operation string) error {
+	stats := r.scanner.WaitRawWrites()
+	if stats.ErrorCount == 0 {
+		return nil
+	}
+	if stats.ErrorCount == stats.Attempts {
+		return fmt.Errorf("%s sent no raw packets: all %d writes failed: %w", operation, stats.Attempts, stats.FirstError)
+	}
+	gologger.Warning().Msgf("%s had %d failed raw packet writes out of %d (first error: %s)\n", operation, stats.ErrorCount, stats.Attempts, stats.FirstError)
+	return nil
+}
+
+func (r *Runner) checkTransportErrors(raw bool) error {
+	if raw {
+		return r.checkRawWriteErrors("scan")
+	}
+	return r.checkConnectErrors()
+}
