+func (r *Runner) addScopedTarget(ip, targetPort string, hasPort bool) error {
+	target := Target{Ip: ip}
+	if hasPort && len(r.options.Ports) == 0 {
+		target.Port = targetPort
+	}
+
+	if r.options.Stream {
+		r.streamChannel <- target
+		return nil
+	}
+
+	key := target.Ip + "|" + target.Port
+	r.scopedTargetsMu.Lock()
+	defer r.scopedTargetsMu.Unlock()
+
+	if r.scopedTargetSet == nil {
+		r.scopedTargetSet = make(map[string]struct{})
+	}
+	if _, exists := r.scopedTargetSet[key]; exists {
+		return nil
+	}
+	r.scopedTargetSet[key] = struct{}{}
+	r.scopedTargets = append(r.scopedTargets, target)
+	return nil
+}
+
+func (r *Runner) scopedTargetsWithPorts() []string {
+	r.scopedTargetsMu.Lock()
+	defer r.scopedTargetsMu.Unlock()
+
+	var targets []string
+	for _, target := range r.scopedTargets {
+		if target.Port != "" {
+			targets = append(targets, net.JoinHostPort(target.Ip, target.Port))
+			continue
+		}
+		for _, p := range r.scanner.Ports {
+			targets = append(targets, net.JoinHostPort(target.Ip, p.String()))
+		}
+	}
+	return targets
+}
+
+func (r *Runner) hostsForIP(ip string) ([]string, error) {
+	if addr, err := netip.ParseAddr(ip); err == nil && addr.Zone() != "" {
+		return []string{"ip"}, nil
+	}
+	return r.scanner.IPRanger.GetHostsByIP(ip)
+}
