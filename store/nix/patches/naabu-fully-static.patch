diff --git b/pkg/scan/capture_linux.go b/pkg/scan/capture_linux.go
new file mode 100644
index 0000000..f736c48
--- /dev/null
+++ b/pkg/scan/capture_linux.go
@@ -0,0 +1,138 @@
+//go:build linux
+
+package scan
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/Mzack9999/gopacket/afpacket"
+	"github.com/Mzack9999/gopacket/layers"
+	"github.com/projectdiscovery/naabu/v2/pkg/protocol"
+	"golang.org/x/net/bpf"
+)
+
+type linuxCaptureHandle struct {
+	*afpacket.TPacket
+}
+
+func (h *linuxCaptureHandle) LinkType() layers.LinkType {
+	return layers.LinkTypeEthernet
+}
+
+func openCaptureHandle(interfaceName, _ string, proto protocol.Protocol) (packetHandle, error) {
+	ports := make([]uint32, len(ListenHandlers))
+	for i, listenHandler := range ListenHandlers {
+		ports[i] = uint32(listenHandler.Port)
+	}
+	filter, err := linuxCaptureFilter(proto, ports)
+	if err != nil {
+		return nil, err
+	}
+
+	handle, err := afpacket.NewTPacket(
+		afpacket.OptInterface(interfaceName),
+		afpacket.OptFrameSize(snaplen),
+		afpacket.OptBlockSize(snaplen),
+		afpacket.OptNumBlocks(2),
+		afpacket.OptPollTimeout(time.Duration(readtimeout)*time.Millisecond),
+	)
+	if err != nil {
+		return nil, err
+	}
+	if err := handle.SetBPF(filter); err != nil {
+		handle.Close()
+		return nil, err
+	}
+
+	return &linuxCaptureHandle{TPacket: handle}, nil
+}
+
+func linuxCaptureFilter(proto protocol.Protocol, ports []uint32) ([]bpf.RawInstruction, error) {
+	var instructions []bpf.Instruction
+	switch proto {
+	case protocol.ARP:
+		instructions = []bpf.Instruction{
+			bpf.LoadAbsolute{Off: 12, Size: 2},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 0x0806, SkipFalse: 1},
+			bpf.RetConstant{Val: snaplen},
+			bpf.RetConstant{Val: 0},
+		}
+	case protocol.TCP, protocol.UDP:
+		if len(ports) == 0 {
+			return nil, fmt.Errorf("no transport capture ports configured")
+		}
+		if len(ports) > 120 {
+			return nil, fmt.Errorf("too many transport capture ports: %d", len(ports))
+		}
+		instructions = linuxTransportCaptureFilter(ports)
+	default:
+		return nil, fmt.Errorf("unsupported capture protocol %q", proto)
+	}
+
+	return bpf.Assemble(instructions)
+}
+
+func linuxTransportCaptureFilter(ports []uint32) []bpf.Instruction {
+	ipv6Start := 8 + len(ports)
+	accept := ipv6Start + 4 + len(ports)
+	reject := accept + 1
+	skip := func(from, to int) uint8 {
+		return uint8(to - from - 1)
+	}
+
+	instructions := make([]bpf.Instruction, 0, reject+1)
+	instructions = append(instructions,
+		bpf.LoadAbsolute{Off: 12, Size: 2},
+		bpf.JumpIf{Cond: bpf.JumpEqual, Val: 0x0800, SkipTrue: 1},
+		bpf.JumpIf{
+			Cond:      bpf.JumpEqual,
+			Val:       0x86dd,
+			SkipTrue:  skip(2, ipv6Start),
+			SkipFalse: skip(2, reject),
+		},
+		bpf.LoadAbsolute{Off: 23, Size: 1},
+		bpf.JumpIf{Cond: bpf.JumpEqual, Val: 6, SkipTrue: 1},
+		bpf.JumpIf{
+			Cond:      bpf.JumpEqual,
+			Val:       17,
+			SkipFalse: skip(5, reject),
+		},
+		bpf.LoadMemShift{Off: 14},
+		bpf.LoadIndirect{Off: 16, Size: 2},
+	)
+	instructions = appendPortChecks(instructions, ports, accept, reject)
+
+	instructions = append(instructions,
+		bpf.LoadAbsolute{Off: 20, Size: 1},
+		bpf.JumpIf{Cond: bpf.JumpEqual, Val: 6, SkipTrue: 1},
+		bpf.JumpIf{
+			Cond:      bpf.JumpEqual,
+			Val:       17,
+			SkipFalse: skip(ipv6Start+2, reject),
+		},
+		bpf.LoadAbsolute{Off: 56, Size: 2},
+	)
+	instructions = appendPortChecks(instructions, ports, accept, reject)
+	return append(instructions,
+		bpf.RetConstant{Val: snaplen},
+		bpf.RetConstant{Val: 0},
+	)
+}
+
+func appendPortChecks(instructions []bpf.Instruction, ports []uint32, accept, reject int) []bpf.Instruction {
+	for i, port := range ports {
+		index := len(instructions)
+		skipFalse := uint8(0)
+		if i == len(ports)-1 {
+			skipFalse = uint8(reject - index - 1)
+		}
+		instructions = append(instructions, bpf.JumpIf{
+			Cond:      bpf.JumpEqual,
+			Val:       port,
+			SkipTrue:  uint8(accept - index - 1),
+			SkipFalse: skipFalse,
+		})
+	}
+	return instructions
+}
diff --git b/pkg/scan/capture_linux_test.go b/pkg/scan/capture_linux_test.go
new file mode 100644
index 0000000..ac43b19
--- /dev/null
+++ b/pkg/scan/capture_linux_test.go
@@ -0,0 +1,70 @@
+//go:build linux
+
+package scan
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/projectdiscovery/naabu/v2/pkg/protocol"
+	"golang.org/x/net/bpf"
+)
+
+func TestLinuxCaptureFilter(t *testing.T) {
+	tests := []struct {
+		name      string
+		filter    protocol.Protocol
+		etherType uint16
+		ipProto   byte
+		dstPort   uint16
+		want      bool
+	}{
+		{name: "arp", filter: protocol.ARP, etherType: 0x0806, want: true},
+		{name: "arp rejects IPv4", filter: protocol.ARP, etherType: 0x0800},
+		{name: "IPv4 TCP", filter: protocol.TCP, etherType: 0x0800, ipProto: 6, dstPort: 4242, want: true},
+		{name: "IPv4 UDP", filter: protocol.TCP, etherType: 0x0800, ipProto: 17, dstPort: 4242, want: true},
+		{name: "IPv4 wrong port", filter: protocol.TCP, etherType: 0x0800, ipProto: 6, dstPort: 53},
+		{name: "IPv4 ICMP", filter: protocol.TCP, etherType: 0x0800, ipProto: 1, dstPort: 4242},
+		{name: "IPv6 TCP", filter: protocol.TCP, etherType: 0x86dd, ipProto: 6, dstPort: 4242, want: true},
+		{name: "IPv6 UDP", filter: protocol.TCP, etherType: 0x86dd, ipProto: 17, dstPort: 4242, want: true},
+		{name: "IPv6 wrong port", filter: protocol.TCP, etherType: 0x86dd, ipProto: 17, dstPort: 53},
+		{name: "unrelated EtherType", filter: protocol.TCP, etherType: 0x0806, ipProto: 6, dstPort: 4242},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			raw, err := linuxCaptureFilter(test.filter, []uint32{4242})
+			if err != nil {
+				t.Fatalf("build filter: %v", err)
+			}
+			instructions, allDecoded := bpf.Disassemble(raw)
+			if !allDecoded {
+				t.Fatal("filter contains undecodable instructions")
+			}
+			vm, err := bpf.NewVM(instructions)
+			if err != nil {
+				t.Fatalf("create BPF VM: %v", err)
+			}
+
+			packet := make([]byte, 64)
+			binary.BigEndian.PutUint16(packet[12:14], test.etherType)
+			switch test.etherType {
+			case 0x0800:
+				packet[14] = 0x45
+				packet[23] = test.ipProto
+				binary.BigEndian.PutUint16(packet[36:38], test.dstPort)
+			case 0x86dd:
+				packet[20] = test.ipProto
+				binary.BigEndian.PutUint16(packet[56:58], test.dstPort)
+			}
+
+			accepted, err := vm.Run(packet)
+			if err != nil {
+				t.Fatalf("run BPF VM: %v", err)
+			}
+			if got := accepted > 0; got != test.want {
+				t.Fatalf("accepted = %t, want %t", got, test.want)
+			}
+		})
+	}
+}
diff --git b/pkg/scan/capture_pcap.go b/pkg/scan/capture_pcap.go
new file mode 100644
index 0000000..e298ba8
--- /dev/null
+++ b/pkg/scan/capture_pcap.go
@@ -0,0 +1,56 @@
+//go:build darwin || windows
+
+package scan
+
+import (
+	"time"
+
+	"github.com/Mzack9999/gopacket/pcap"
+	"github.com/projectdiscovery/naabu/v2/pkg/protocol"
+)
+
+type pcapCaptureHandle struct {
+	*pcap.Handle
+	inactive *pcap.InactiveHandle
+}
+
+func (h *pcapCaptureHandle) Close() {
+	h.Handle.Close()
+	h.inactive.CleanUp()
+}
+
+func openCaptureHandle(interfaceName, bpfFilter string, _ protocol.Protocol) (packetHandle, error) {
+	inactive, err := pcap.NewInactiveHandle(interfaceName)
+	if err != nil {
+		return nil, err
+	}
+
+	if err := inactive.SetSnapLen(snaplen); err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+	if err := inactive.SetTimeout(time.Duration(readtimeout) * time.Millisecond); err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+	if err := inactive.SetImmediateMode(true); err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+
+	handle, err := inactive.Activate()
+	if err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+	if err := handle.SetBPFFilter(bpfFilter); err != nil {
+		handle.Close()
+		inactive.CleanUp()
+		return nil, err
+	}
+
+	return &pcapCaptureHandle{
+		Handle:   handle,
+		inactive: inactive,
+	}, nil
+}
