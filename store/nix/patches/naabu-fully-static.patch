+// RawWriteStats summarizes completed raw packet writes.
+type RawWriteStats struct {
+	Attempts   uint64
+	ErrorCount uint64
+	FirstError error
+}
+
+// ResetRawWriteStats starts a new raw packet accounting interval.
+// No writes from the previous interval may still be pending.
+func (s *Scanner) ResetRawWriteStats() {
+	s.rawAttempts.Store(0)
+	s.rawErrors.Store(0)
+	s.rawErrorMu.Lock()
+	s.firstRawError = nil
+	s.rawErrorMu.Unlock()
+}
+
+func (s *Scanner) beginRawWrite() {
+	s.rawAttempts.Add(1)
+	s.rawWritesWg.Add(1)
+}
+
+func (s *Scanner) finishRawWrite(err error) {
+	if err != nil {
+		s.rawErrors.Add(1)
+		s.rawErrorMu.Lock()
+		if s.firstRawError == nil {
+			s.firstRawError = err
+		}
+		s.rawErrorMu.Unlock()
+	}
+	s.rawWritesWg.Done()
+}
+
+// RecordRawWrite records a synchronous raw packet write.
+func (s *Scanner) RecordRawWrite(err error) {
+	s.rawAttempts.Add(1)
+	if err == nil {
+		return
+	}
+	s.rawErrors.Add(1)
+	s.rawErrorMu.Lock()
+	if s.firstRawError == nil {
+		s.firstRawError = err
+	}
+	s.rawErrorMu.Unlock()
+}
+
+// WaitRawWrites waits for queued writes and returns their outcome.
+func (s *Scanner) WaitRawWrites() RawWriteStats {
+	s.rawWritesWg.Wait()
+	s.rawErrorMu.Lock()
+	firstError := s.firstRawError
+	s.rawErrorMu.Unlock()
+	return RawWriteStats{
+		Attempts:   s.rawAttempts.Load(),
+		ErrorCount: s.rawErrors.Load(),
+		FirstError: firstError,
+	}
+}
