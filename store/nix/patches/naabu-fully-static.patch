+func sendWithConn6(destIP string, conn *ipv6.PacketConn, sourceIP net.IP, iface *net.Interface, zone string, l ...gopacket.SerializableLayer) error {
+	buf := gopacket.NewSerializeBuffer()
+	if err := gopacket.SerializeLayers(buf, defaultSerializeOptions, l...); err != nil {
+		return err
+	}
+	data := buf.Bytes()
+	addr, err := netip.ParseAddr(destIP)
+	if err != nil {
+		return fmt.Errorf("invalid IPv6 destination %q: %w", destIP, err)
+	}
+	if zone == "" && addr.IsLinkLocalUnicast() {
+		zone = iface.Name
+	}
+	destination := &net.IPAddr{
+		IP:   net.IP(addr.WithZone("").AsSlice()),
+		Zone: zone,
+	}
+	control := &ipv6.ControlMessage{
+		Src:     sourceIP,
+		IfIndex: iface.Index,
+	}
+
+	return writeWithConn6(conn, data, control, destination)
+}
+
+func writeWithConn6(conn *ipv6.PacketConn, data []byte, control *ipv6.ControlMessage, destination net.Addr) error {
+	var err error
+	for range maxRetries {
+		_, err = conn.WriteTo(data, control, destination)
+		if err == nil {
+			return nil
+		}
+		time.Sleep(time.Duration(sendDelayMsec) * time.Millisecond)
+	}
+	return fmt.Errorf("could not send packet to %s: %w", destination, err)
+}
 
