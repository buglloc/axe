new file mode 100644
index 0000000..1ef927f
--- /dev/null
+++ b/pkg/runner/internal/rawsend/batch_linux.go
@@ -0,0 +1,113 @@
+//go:build linux
+
+package rawsend
+
+import (
+	"runtime"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+type mmsghdr struct {
+	Hdr    unix.Msghdr
+	MsgLen uint32
+}
+
+type sockaddrInet4Raw struct {
+	Family uint16
+	Port   uint16
+	Addr   [4]byte
+	Zero   [8]byte
+}
+
+// Batch accumulates raw IPv4 packets and sends them with sendmmsg.
+type Batch struct {
+	fd        socketFD
+	count     int
+	batchSize int
+	maxPktLen int
+	pkts      []byte
+	pktLens   []int
+	addrs     []sockaddrInet4Raw
+	iovs      []unix.Iovec
+	msgs      []mmsghdr
+}
+
+// NewBatch creates a sender that batches up to batchSize packets.
+func NewBatch(fd socketFD, batchSize, maxPktLen int) *Batch {
+	batch := &Batch{
+		fd:        fd,
+		batchSize: batchSize,
+		maxPktLen: maxPktLen,
+		pkts:      make([]byte, batchSize*maxPktLen),
+		pktLens:   make([]int, batchSize),
+		addrs:     make([]sockaddrInet4Raw, batchSize),
+		iovs:      make([]unix.Iovec, batchSize),
+		msgs:      make([]mmsghdr, batchSize),
+	}
+	for i := range batchSize {
+		batch.addrs[i].Family = syscall.AF_INET
+		batch.iovs[i].Base = &batch.pkts[i*maxPktLen]
+		batch.msgs[i].Hdr.Name = (*byte)(unsafe.Pointer(&batch.addrs[i]))
+		batch.msgs[i].Hdr.Namelen = uint32(unsafe.Sizeof(batch.addrs[i]))
+		batch.msgs[i].Hdr.Iov = &batch.iovs[i]
+		batch.msgs[i].Hdr.Iovlen = 1
+	}
+	return batch
+}
+
+// Add queues pkt and flushes a full batch.
+func (b *Batch) Add(pkt []byte, dstIP [4]byte) error {
+	i := b.count
+	offset := i * b.maxPktLen
+	n := copy(b.pkts[offset:offset+b.maxPktLen], pkt)
+	b.pktLens[i] = n
+	b.iovs[i].SetLen(n)
+	b.addrs[i].Addr = dstIP
+	b.count++
+	if b.count == b.batchSize {
+		return b.Flush()
+	}
+	return nil
+}
+
+// Flush sends every queued packet, retrying partial sendmmsg results.
+func (b *Batch) Flush() error {
+	if b.count == 0 {
+		return nil
+	}
+
+	n := b.count
+	b.count = 0
+
+	sent := 0
+	for sent < n {
+		r1, _, errno := unix.Syscall6(
+			unix.SYS_SENDMMSG,
+			uintptr(b.fd),
+			uintptr(unsafe.Pointer(&b.msgs[sent])),
+			uintptr(n-sent),
+			0,
+			0,
+			0,
+		)
+		runtime.KeepAlive(b)
+		if errno != 0 {
+			return errno
+		}
+
+		count := int(r1)
+		if count == 0 {
+			return syscall.EAGAIN
+		}
+		sent += count
+	}
+	return nil
+}
+
+// Len returns the number of queued packets.
+func (b *Batch) Len() int {
+	return b.count
+}
