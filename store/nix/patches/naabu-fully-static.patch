+func sendWithConn6(destination *net.IPAddr, conn *ipv6.PacketConn, sourceIP net.IP, iface *net.Interface, l ...gopacket.SerializableLayer) error {
+	buf := gopacket.NewSerializeBuffer()
+	if err := gopacket.SerializeLayers(buf, defaultSerializeOptions, l...); err != nil {
+		return err
+	}
+	control := &ipv6.ControlMessage{Src: sourceIP}
+	if iface != nil {
+		control.IfIndex = iface.Index
+		if destination.Zone == "" && destination.IP.IsLinkLocalUnicast() {
+			destination.Zone = iface.Name
+		}
+	}
+	return writeWithConn6(conn, buf.Bytes(), control, destination)
+}
+
+func writeWithConn6(conn *ipv6.PacketConn, data []byte, control *ipv6.ControlMessage, destination net.Addr) error {
+	var err error
+	for range maxRetries {
+		_, err = conn.WriteTo(data, control, destination)
+		if err == nil {
+			return nil
+		}
+		time.Sleep(time.Duration(sendDelayMsec) * time.Millisecond)
+	}
+	return fmt.Errorf("could not send packet to %s: %w", destination, err)
+}
