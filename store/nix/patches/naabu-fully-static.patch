diff --git a/pkg/scan/capture_linux.go b/pkg/scan/capture_linux.go
new file mode 100644
--- /dev/null
+++ b/pkg/scan/capture_linux.go
@@ -0,0 +1,90 @@
+//go:build linux
+
+package scan
+
+import (
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/Mzack9999/gopacket/afpacket"
+	"github.com/Mzack9999/gopacket/layers"
+	"github.com/projectdiscovery/naabu/v2/pkg/protocol"
+	"golang.org/x/net/bpf"
+)
+
+type linuxCaptureHandle struct {
+	*afpacket.TPacket
+}
+
+func (h *linuxCaptureHandle) LinkType() layers.LinkType {
+	return layers.LinkTypeEthernet
+}
+
+func (h *linuxCaptureHandle) IsTimeout(err error) bool {
+	return errors.Is(err, afpacket.ErrTimeout)
+}
+
+func openCaptureHandle(interfaceName, _ string, proto protocol.Protocol) (packetHandle, error) {
+	filter, err := linuxCaptureFilter(proto)
+	if err != nil {
+		return nil, err
+	}
+
+	// Blocks must be page-aligned even though captured packets are much smaller.
+	const blockSize = 1 << 20
+	handle, err := afpacket.NewTPacket(
+		afpacket.OptInterface(interfaceName),
+		afpacket.OptFrameSize(snaplen),
+		afpacket.OptBlockSize(blockSize),
+		afpacket.OptNumBlocks(pcapBufferSize/blockSize),
+		afpacket.OptBlockTimeout(time.Millisecond),
+		afpacket.OptPollTimeout(time.Duration(readtimeout)*time.Millisecond),
+	)
+	if err != nil {
+		return nil, err
+	}
+	if err := handle.SetBPF(filter); err != nil {
+		handle.Close()
+		return nil, err
+	}
+
+	return &linuxCaptureHandle{TPacket: handle}, nil
+}
+
+func linuxCaptureFilter(proto protocol.Protocol) ([]bpf.RawInstruction, error) {
+	var instructions []bpf.Instruction
+	switch proto {
+	case protocol.ARP:
+		instructions = []bpf.Instruction{
+			bpf.LoadAbsolute{Off: 12, Size: 2},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 0x0806, SkipFalse: 1},
+			bpf.RetConstant{Val: snaplen},
+			bpf.RetConstant{Val: 0},
+		}
+	case protocol.TCP, protocol.UDP:
+		// Handlers acquire source ports after capture starts. Match IPv4 ACK/RST,
+		// IPv6 TCP and UDP here; the reader demultiplexes by the live handler port.
+		instructions = []bpf.Instruction{
+			bpf.LoadAbsolute{Off: 12, Size: 2},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 0x0800, SkipTrue: 1},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 0x86dd, SkipTrue: 8, SkipFalse: 12},
+			bpf.LoadAbsolute{Off: 23, Size: 1},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 17, SkipTrue: 9},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 6, SkipFalse: 9},
+			bpf.LoadAbsolute{Off: 20, Size: 2},
+			bpf.JumpIf{Cond: bpf.JumpBitsSet, Val: 0x1fff, SkipTrue: 7},
+			bpf.LoadMemShift{Off: 14},
+			bpf.LoadIndirect{Off: 27, Size: 1},
+			bpf.JumpIf{Cond: bpf.JumpBitsSet, Val: 0x14, SkipTrue: 3, SkipFalse: 4},
+			bpf.LoadAbsolute{Off: 20, Size: 1},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 6, SkipTrue: 1},
+			bpf.JumpIf{Cond: bpf.JumpEqual, Val: 17, SkipFalse: 1},
+			bpf.RetConstant{Val: snaplen},
+			bpf.RetConstant{Val: 0},
+		}
+	default:
+		return nil, fmt.Errorf("unsupported capture protocol %q", proto)
+	}
+	return bpf.Assemble(instructions)
+}
diff --git a/pkg/scan/capture_linux_test.go b/pkg/scan/capture_linux_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/scan/capture_linux_test.go
@@ -0,0 +1,80 @@
+//go:build linux
+
+package scan
+
+import (
+	"encoding/binary"
+	"fmt"
+	"testing"
+
+	"github.com/projectdiscovery/naabu/v2/pkg/protocol"
+	"golang.org/x/net/bpf"
+)
+
+func TestLinuxCaptureFilter(t *testing.T) {
+	tests := []struct {
+		name      string
+		filter    protocol.Protocol
+		etherType uint16
+		ipProto   byte
+		flags     byte
+		fragment  uint16
+		want      bool
+	}{
+		{name: "arp", filter: protocol.ARP, etherType: 0x0806, want: true},
+		{name: "arp rejects IPv4", filter: protocol.ARP, etherType: 0x0800},
+		{name: "IPv4 SYN-ACK", filter: protocol.TCP, etherType: 0x0800, ipProto: 6, flags: 0x12, want: true},
+		{name: "IPv4 ACK", filter: protocol.TCP, etherType: 0x0800, ipProto: 6, flags: 0x10, want: true},
+		{name: "IPv4 RST", filter: protocol.TCP, etherType: 0x0800, ipProto: 6, flags: 0x04, want: true},
+		{name: "IPv4 pure SYN", filter: protocol.TCP, etherType: 0x0800, ipProto: 6, flags: 0x02},
+		{name: "IPv4 noninitial TCP fragment", filter: protocol.TCP, etherType: 0x0800, ipProto: 6, flags: 0x12, fragment: 1},
+		{name: "IPv4 UDP", filter: protocol.TCP, etherType: 0x0800, ipProto: 17, want: true},
+		{name: "IPv4 ICMP", filter: protocol.TCP, etherType: 0x0800, ipProto: 1},
+		{name: "IPv6 TCP", filter: protocol.TCP, etherType: 0x86dd, ipProto: 6, want: true},
+		{name: "IPv6 UDP", filter: protocol.TCP, etherType: 0x86dd, ipProto: 17, want: true},
+		{name: "IPv6 ICMP", filter: protocol.TCP, etherType: 0x86dd, ipProto: 58},
+		{name: "unrelated EtherType", filter: protocol.TCP, etherType: 0x0806, ipProto: 6, flags: 0x12},
+	}
+
+	for _, test := range tests {
+		// Exercise ports unavailable at capture initialization, including zero.
+		for _, dstPort := range []uint16{0, 53, 4242, 65535} {
+			t.Run(fmt.Sprintf("%s/port-%d", test.name, dstPort), func(t *testing.T) {
+				raw, err := linuxCaptureFilter(test.filter)
+				if err != nil {
+					t.Fatalf("build filter: %v", err)
+				}
+				instructions, allDecoded := bpf.Disassemble(raw)
+				if !allDecoded {
+					t.Fatal("filter contains undecodable instructions")
+				}
+				vm, err := bpf.NewVM(instructions)
+				if err != nil {
+					t.Fatalf("create BPF VM: %v", err)
+				}
+
+				packet := make([]byte, 80)
+				binary.BigEndian.PutUint16(packet[12:14], test.etherType)
+				switch test.etherType {
+				case 0x0800:
+					packet[14] = 0x45
+					packet[23] = test.ipProto
+					binary.BigEndian.PutUint16(packet[20:22], test.fragment)
+					binary.BigEndian.PutUint16(packet[36:38], dstPort)
+					packet[47] = test.flags
+				case 0x86dd:
+					packet[20] = test.ipProto
+					binary.BigEndian.PutUint16(packet[56:58], dstPort)
+				}
+
+				accepted, err := vm.Run(packet)
+				if err != nil {
+					t.Fatalf("run BPF VM: %v", err)
+				}
+				if got := accepted > 0; got != test.want {
+					t.Fatalf("accepted = %t, want %t", got, test.want)
+				}
+			})
+		}
+	}
+}
