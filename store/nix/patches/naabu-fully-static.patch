new file mode 100644
--- /dev/null
+++ b/pkg/scan/capture_pcap.go
@@ -0,0 +1,71 @@
+//go:build darwin || windows
+
+package scan
+
+import (
+	"errors"
+	"net"
+	"time"
+
+	"github.com/Mzack9999/gopacket/pcap"
+	"github.com/projectdiscovery/gologger"
+	"github.com/projectdiscovery/naabu/v2/pkg/protocol"
+)
+
+type pcapCaptureHandle struct {
+	*pcap.Handle
+	inactive *pcap.InactiveHandle
+}
+
+func (h *pcapCaptureHandle) Close() {
+	h.Handle.Close()
+	h.inactive.CleanUp()
+}
+
+func (h *pcapCaptureHandle) IsTimeout(err error) bool {
+	return errors.Is(err, pcap.NextErrorTimeoutExpired)
+}
+
+func openCaptureHandle(interfaceName, bpfFilter string, _ protocol.Protocol) (packetHandle, error) {
+	iface, err := net.InterfaceByName(interfaceName)
+	if err != nil {
+		return nil, err
+	}
+	inactive, err := pcap.NewInactiveHandle(pcapDeviceForInterface(iface))
+	if err != nil {
+		return nil, err
+	}
+
+	if err := inactive.SetSnapLen(snaplen); err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+	if err := inactive.SetTimeout(time.Duration(readtimeout) * time.Millisecond); err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+	if err := inactive.SetImmediateMode(true); err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+
+	if err := inactive.SetBufferSize(pcapBufferSize); err != nil {
+		gologger.Debug().Msgf("could not set pcap buffer size on %s: %s", interfaceName, err)
+	}
+
+	handle, err := inactive.Activate()
+	if err != nil {
+		inactive.CleanUp()
+		return nil, err
+	}
+	if err := handle.SetBPFFilter(bpfFilter); err != nil {
+		handle.Close()
+		inactive.CleanUp()
+		return nil, err
+	}
+
+	return &pcapCaptureHandle{
+		Handle:   handle,
+		inactive: inactive,
+	}, nil
+}
