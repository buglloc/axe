@@ -0,0 +1,47 @@
+// Package rawsend provides direct raw IPv4 packet sending without CGO.
+package rawsend
+
+import (
+	"net"
+	"syscall"
+)
+
+type socketFD = sysSocketFD
+
+// Sender sends raw IPv4 packets through the file descriptor owned by conn.
+type Sender struct {
+	fd   socketFD
+	conn *net.IPConn
+	sa   syscall.SockaddrInet4
+}
+
+// NewFromIPConn creates a Sender and retains conn to keep its descriptor open.
+func NewFromIPConn(conn *net.IPConn) (*Sender, error) {
+	rawConn, err := conn.SyscallConn()
+	if err != nil {
+		return nil, err
+	}
+
+	var fd socketFD
+	if err := rawConn.Control(func(rawFD uintptr) {
+		fd = socketFD(rawFD)
+	}); err != nil {
+		return nil, err
+	}
+
+	return &Sender{
+		fd:   fd,
+		conn: conn,
+	}, nil
+}
+
+// FD returns the raw socket descriptor.
+func (s *Sender) FD() socketFD {
+	return s.fd
+}
+
+// SendTo sends pkt to dstIP. Sender is not safe for concurrent use.
+func (s *Sender) SendTo(pkt []byte, dstIP [4]byte) error {
+	s.sa.Addr = dstIP
+	return syscall.Sendto(s.fd, pkt, 0, &s.sa)
+}
