--- /dev/null
+++ b/src/axe_roots.rs
@@ -0,0 +1,15 @@
+use anyhow::{Context, Result, ensure};
+use reqwest::Certificate;
+
+const AXE_CA_BUNDLE: &[u8] = include_bytes!("axe-ca-bundle.pem");
+
+pub fn certificates() -> Result<Vec<Certificate>> {
+    let certificates = Certificate::from_pem_bundle(AXE_CA_BUNDLE)
+        .context("failed to parse embedded AXE CA bundle")?;
+    ensure!(
+        !certificates.is_empty(),
+        "embedded AXE CA bundle must contain at least one certificate"
+    );
+
+    Ok(certificates)
+}
