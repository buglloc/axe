+#[cfg(test)]
+mod embedded_default_tests {
+    use super::*;
+
+    #[test]
+    fn loads_defaults_and_imports_without_creating_files() {
+        let temp = tempfile::tempdir().unwrap();
+        let dir = temp.path().join("broot");
+        let mut conf = Conf::default();
+        conf.read_file_with_defaults(dir.join("conf.hjson"), Some(&dir))
+            .unwrap();
+        assert_eq!(conf.show_selection_mark, Some(true));
+        assert_eq!(conf.content_search_max_file_size, Some(10_000_000));
+        assert!(
+            conf.verbs
+                .iter()
+                .any(|v| v.invocation.as_deref() == Some("edit"))
+        );
+        assert!(conf.skin.as_ref().is_some_and(|skin| !skin.is_empty()));
+        assert!(!dir.exists());
+    }
+
+    #[test]
+    fn uses_existing_imports_and_rejects_malformed_ones() {
+        let temp = tempfile::tempdir().unwrap();
+        let dir = temp.path();
+        let verbs = dir.join("verbs.hjson");
+        std::fs::write(&verbs, "show_selection_mark: false").unwrap();
+        let mut conf = Conf::default();
+        conf.read_file_with_defaults(dir.join("conf.hjson"), Some(dir))
+            .unwrap();
+        assert_eq!(conf.show_selection_mark, Some(false));
+        assert!(conf.verbs.is_empty());
+        assert!(!dir.join("conf.hjson").exists());
+
+        std::fs::write(&verbs, "verbs: [ }").unwrap();
+        assert!(
+            Conf::default()
+                .read_file_with_defaults(dir.join("conf.hjson"), Some(dir))
+                .is_err()
+        );
+        assert!(!dir.join("conf.hjson").exists());
+    }
+
+    #[test]
+    fn existing_configs_do_not_use_embedded_import_fallback() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = temp.path().join("conf.hjson");
+        std::fs::write(&path, r#"{"imports":["verbs.hjson"]}"#).unwrap();
+        assert!(matches!(
+            Conf::default().read_file(path),
+            Err(ProgramError::Conf {
+                source: ConfError::ImportNotFound { .. }
+            })
+        ));
+        assert!(!temp.path().join("verbs.hjson").exists());
+    }
+}
