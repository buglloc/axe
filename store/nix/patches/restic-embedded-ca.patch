diff --git a/cmd/restic/axe_ca.go b/cmd/restic/axe_ca.go
new file mode 100644
--- /dev/null
+++ b/cmd/restic/axe_ca.go
@@ -0,0 +1,18 @@
+package main
+
+import (
+	"crypto/x509"
+	_ "embed"
+)
+
+//go:embed axe-ca-bundle.pem
+var axeCABundle []byte
+
+func init() {
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(axeCABundle) {
+		panic("embedded AXE CA bundle is empty or invalid")
+	}
+
+	x509.SetFallbackRoots(roots)
+}
