#!/usr/bin/env python3
"""AXE bootstrap, generated by bootstrap/generate.py.

Download the static axe release from pinned addresses, check its size and
SHA-256, and run it without installing anything.

usage: python3 - [--output PATH] [--no-exec] [--] [AXE ARG ...]
"""

import hashlib
import os
import platform
import socket
import ssl
import sys
import tempfile

DATA = @@DATA@@
MACHINES = {
    "x86_64": "x86_64-linux",
    "amd64": "x86_64-linux",
    "aarch64": "aarch64-linux",
    "arm64": "aarch64-linux",
}
TIMEOUT = 10
USAGE = "usage: python3 - [--output PATH] [--no-exec] [--] [AXE ARG ...]"


class BootstrapError(Exception):
    pass


def select_target():
    if not sys.platform.startswith("linux"):
        raise BootstrapError(f"unsupported operating system: {sys.platform}")

    name = os.environ.get("AXE_BOOTSTRAP_TARGET") or platform.machine().lower()
    target = MACHINES.get(name, name)
    if target not in DATA["targets"]:
        raise BootstrapError(f"unsupported architecture: {name}")
    return DATA["targets"][target]


def parse_arguments(argv):
    output = None
    execute = True

    while argv:
        item = argv[0]
        if item == "--output":
            if len(argv) < 2:
                raise BootstrapError("--output requires a path")
            output = argv[1]
            argv = argv[2:]
        elif item == "--no-exec":
            execute = False
            argv = argv[1:]
        elif item in ("-h", "--help"):
            print(USAGE, file=sys.stderr)
            raise SystemExit(0)
        elif item == "--":
            argv = argv[1:]
            break
        else:
            break

    return output, execute, list(argv) or list(DATA["default_args"])


def fetch(manifest, address, tls):
    """Return the response body from one pinned address."""

    port = manifest["ports"]["https" if tls else "http"]
    connection = socket.create_connection((address, port), TIMEOUT)
    with connection:
        if tls:
            connection = ssl.create_default_context().wrap_socket(
                connection, server_hostname=manifest["host"]
            )

        request = f"GET {manifest['path']} HTTP/1.0\r\nHost: {manifest['host']}\r\n\r\n"
        connection.sendall(request.encode("ascii"))

        chunks = []
        while True:
            chunk = connection.recv(1 << 20)
            if not chunk:
                break
            chunks.append(chunk)

    head, separator, body = b"".join(chunks).partition(b"\r\n\r\n")
    if not separator or head.split(b" ")[1:2] != [b"200"]:
        raise BootstrapError(head.split(b"\r\n", 1)[0].decode("latin-1") or "empty response")
    return body


def download(manifest):
    """Try HTTPS, then plain HTTP, on every address; return verified bytes."""

    failures = []
    for tls in (True, False):
        for address in manifest["addresses"]:
            scheme = "https" if tls else "http"
            try:
                body = fetch(manifest, address, tls)
            except (OSError, BootstrapError) as error:
                failures.append(f"{scheme} {address}: {error}")
                continue

            if len(body) != manifest["size"]:
                failures.append(f"{scheme} {address}: got {len(body)} bytes, expected {manifest['size']}")
            elif hashlib.sha256(body).hexdigest() != manifest["sha256"]:
                failures.append(f"{scheme} {address}: SHA-256 mismatch")
            else:
                return body

    raise BootstrapError("download failed: " + "; ".join(failures))


def write_executable(path, payload):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    partial = f"{path}.part"
    with open(partial, "wb") as file:
        file.write(payload)
    os.chmod(partial, 0o700)
    os.replace(partial, path)


def exec_memfd(payload, arguments):
    """Run the payload from an anonymous file; return only on failure."""

    if not hasattr(os, "memfd_create"):
        return
    try:
        descriptor = os.memfd_create("axe")
        view = memoryview(payload)
        while view:
            view = view[os.write(descriptor, view):]
        os.execve(descriptor, ["axe", *arguments], os.environ)
    except OSError:
        pass


def exec_temporary(payload, arguments):
    """Run the payload from the first temporary directory that allows exec."""

    candidates = [
        os.environ.get("AXE_BOOTSTRAP_DIR"),
        os.environ.get("TMPDIR"),
        "/dev/shm",
        "/tmp",
        "/var/tmp",
        os.environ.get("HOME"),
        os.getcwd(),
    ]
    for directory in filter(None, candidates):
        try:
            work = tempfile.mkdtemp(prefix="axe.", dir=directory)
        except OSError:
            continue

        path = os.path.join(work, "axe")
        try:
            write_executable(path, payload)
            os.execv(path, ["axe", *arguments])
        except OSError:
            # Most likely a noexec mount; clean up and try the next one.
            for name in os.listdir(work):
                os.unlink(os.path.join(work, name))
            os.rmdir(work)

    raise BootstrapError("cannot execute the download from any temporary directory")


def main(argv):
    try:
        manifest = select_target()
        output, execute, arguments = parse_arguments(argv)
        payload = download(manifest)

        if output is not None:
            write_executable(output, payload)
            if execute:
                os.execv(output, [output, *arguments])
            return 0

        if not execute:
            raise BootstrapError("--no-exec requires --output")

        exec_memfd(payload, arguments)
        exec_temporary(payload, arguments)
    except (OSError, BootstrapError) as error:
        print(f"axe bootstrap: {error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
