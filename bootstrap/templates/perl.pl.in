#!/usr/bin/env perl
# AXE bootstrap, generated by bootstrap/generate.py: download the static axe
# release from pinned addresses, check its size and SHA-256, and run it.
#
# usage: perl - [--output PATH] [--no-exec] [--] [AXE ARG ...]
use strict;
use warnings;
use File::Basename qw(dirname);
use File::Path qw(make_path);
use File::Temp qw(tempdir);
use IO::Socket::INET;
use POSIX qw(uname);

my $DATA = @@DATA@@;
my %MACHINES = (
    x86_64 => 'x86_64-linux',
    amd64 => 'x86_64-linux',
    aarch64 => 'aarch64-linux',
    arm64 => 'aarch64-linux',
);
my $TIMEOUT = 10;
my $USAGE = "usage: perl - [--output PATH] [--no-exec] [--] [AXE ARG ...]\n";

sub select_target {
    my ($system, undef, undef, undef, $machine) = uname();
    die "unsupported operating system: $system\n" unless $system eq 'Linux';

    my $name = $ENV{AXE_BOOTSTRAP_TARGET} || lc $machine;
    my $target = $MACHINES{$name} || $name;
    die "unsupported architecture: $name\n" unless $DATA->{targets}{$target};
    return $DATA->{targets}{$target};
}

sub parse_arguments {
    my @argv = @_;
    my $output;
    my $execute = 1;

    while (@argv) {
        if ($argv[0] eq '--output') {
            die "--output requires a path\n" unless @argv >= 2;
            (undef, $output) = splice @argv, 0, 2;
        } elsif ($argv[0] eq '--no-exec') {
            $execute = 0;
            shift @argv;
        } elsif ($argv[0] eq '-h' || $argv[0] eq '--help') {
            print STDERR $USAGE;
            exit 0;
        } elsif ($argv[0] eq '--') {
            shift @argv;
            last;
        } else {
            last;
        }
    }

    @argv = @{ $DATA->{default_args} } unless @argv;
    return ($output, $execute, @argv);
}

sub sha256_hex {
    my ($data) = @_;

    if (eval { require Digest::SHA; 1 }) {
        return Digest::SHA::sha256_hex($data);
    }

    # perl-base without Digest::SHA: fall back to a system tool.
    my ($file, $name) = File::Temp::tempfile(UNLINK => 1);
    binmode $file;
    print {$file} $data;
    close $file;
    my $line = `sha256sum '$name' 2>/dev/null` || '';
    my ($sum) = split ' ', $line;
    die "no SHA-256 implementation available\n" unless $sum;
    return $sum;
}

sub connect_to {
    my ($manifest, $address, $tls) = @_;
    my %options = (
        PeerAddr => $address,
        PeerPort => $manifest->{ports}{ $tls ? 'https' : 'http' },
        Proto => 'tcp',
        Timeout => $TIMEOUT,
    );

    if ($tls) {
        die "IO::Socket::SSL is not installed\n" unless eval { require IO::Socket::SSL; 1 };
        return IO::Socket::SSL->new(
            %options,
            SSL_hostname => $manifest->{host},
            SSL_verifycn_name => $manifest->{host},
            SSL_verify_mode => IO::Socket::SSL::SSL_VERIFY_PEER(),
        ) || die "TLS connection failed\n";
    }

    my $class = eval { require IO::Socket::IP; 'IO::Socket::IP' } || 'IO::Socket::INET';
    return $class->new(%options) || die "connection failed\n";
}

# Return the response body from one pinned address. Only sysread is used:
# mixing it with buffered readline would drop body bytes.
sub fetch {
    my ($manifest, $address, $tls) = @_;
    my $socket = connect_to($manifest, $address, $tls);
    syswrite $socket, "GET $manifest->{path} HTTP/1.0\r\nHost: $manifest->{host}\r\n\r\n";

    my $data = '';
    while (1) {
        my $count = sysread $socket, my $chunk, 1 << 20;
        die "read failed: $!\n" unless defined $count;
        last if $count == 0;
        $data .= $chunk;
    }
    close $socket;

    my ($head, $body) = split /\r\n\r\n/, $data, 2;
    my ($status) = split /\r\n/, $head // '';
    die(($status || 'empty response') . "\n") unless defined $body && $status =~ m{^HTTP/\S+ 200 };
    return $body;
}

# Try HTTPS, then plain HTTP, on every address; return verified bytes.
sub download {
    my ($manifest) = @_;
    my @failures;

    for my $tls (1, 0) {
        for my $address (@{ $manifest->{addresses} }) {
            my $label = ($tls ? 'https' : 'http') . " $address";
            my $body = eval { fetch($manifest, $address, $tls) };
            if (!defined $body) {
                (my $error = $@) =~ s/\s+\z//;
                push @failures, "$label: $error";
                next;
            }

            if (length $body != $manifest->{size}) {
                push @failures, "$label: got " . length($body) . " bytes, expected $manifest->{size}";
            } elsif (sha256_hex($body) ne $manifest->{sha256}) {
                push @failures, "$label: SHA-256 mismatch";
            } else {
                return $body;
            }
        }
    }

    die 'download failed: ' . join('; ', @failures) . "\n";
}

sub write_executable {
    my ($path, $payload) = @_;
    my $partial = "$path.part";

    make_path(dirname($path));
    open my $file, '>:raw', $partial or die "cannot write $partial: $!\n";
    print {$file} $payload or die "cannot write $partial: $!\n";
    close $file or die "cannot write $partial: $!\n";
    chmod 0700, $partial or die "cannot chmod $partial: $!\n";
    rename $partial, $path or die "cannot rename $partial: $!\n";
}

# exec returns only on failure (for example, a noexec mount), so every
# temporary directory can be tried in turn.
sub exec_temporary {
    my ($payload, @args) = @_;
    my @candidates = (
        $ENV{AXE_BOOTSTRAP_DIR},
        $ENV{TMPDIR},
        '/dev/shm',
        '/tmp',
        '/var/tmp',
        $ENV{HOME},
        '.',
    );

    for my $directory (grep { defined && length } @candidates) {
        my $work = eval { tempdir('axe.XXXXXX', DIR => $directory) } or next;
        my $path = "$work/axe";

        if (eval { write_executable($path, $payload); 1 }) {
            # A failed exec is expected on noexec mounts; do not warn.
            no warnings 'exec';
            exec { $path } 'axe', @args;
        }
        unlink $path;
        rmdir $work;
    }

    die "cannot execute the download from any temporary directory\n";
}

eval {
    my $manifest = select_target();
    my ($output, $execute, @args) = parse_arguments(@ARGV);
    my $payload = download($manifest);

    if (defined $output) {
        write_executable($output, $payload);
        exit 0 unless $execute;
        my $path = $output =~ m{/} ? $output : "./$output";
        exec { $path } $path, @args;
        die "cannot execute $path: $!\n";
    }

    die "--no-exec requires --output\n" unless $execute;
    exec_temporary($payload, @args);
};
print STDERR "axe bootstrap: $@";
exit 1;
