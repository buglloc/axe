#!/bin/sh
# AXE bootstrap, generated by bootstrap/generate.py: download the static axe
# release, check its size and SHA-256, and run it.
#
# usage: sh - [--output PATH] [--no-exec] [--] [AXE ARG ...]

set -u
umask 077

say() {
    printf 'axe bootstrap: %s\n' "$*" >&2
}

have() {
    command -v "$1" >/dev/null 2>&1
}

system=$( (uname -s || busybox uname -s) 2>/dev/null )
machine=$( (uname -m || busybox uname -m) 2>/dev/null )

if [ "$system" != Linux ]; then
    say "unsupported operating system: $system"
    exit 1
fi

case ${AXE_BOOTSTRAP_TARGET:-$machine} in
@@TARGETS@@
    *)
        say "unsupported architecture: ${AXE_BOOTSTRAP_TARGET:-$machine}"
        exit 1
        ;;
esac

OUTPUT=
EXECUTE=1

while [ "$#" -gt 0 ]; do
    case $1 in
        --output)
            if [ "$#" -lt 2 ]; then
                say '--output requires a path'
                exit 2
            fi
            OUTPUT=$2
            shift 2
            ;;
        --no-exec)
            EXECUTE=0
            shift
            ;;
        -h|--help)
            say 'usage: sh - [--output PATH] [--no-exec] [--] [AXE ARG ...]'
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -eq 0 ]; then
    set -- @@DEFAULT_ARGS@@
fi

WORK=

cleanup() {
    if [ -n "$WORK" ]; then
        rm -rf -- "$WORK"
    fi
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Pick a private directory on a filesystem that allows execution: a tiny probe
# script must run there (noexec /tmp is common). If the probe cannot pass
# anywhere, the first writable directory is used.
make_workdir() {
    fallback=
    interpreter=$(command -v sh)
    case $interpreter in
        /*) ;;
        *) interpreter=/bin/sh ;;
    esac

    for dir in "${AXE_BOOTSTRAP_DIR:-}" "${TMPDIR:-}" /dev/shm /tmp /var/tmp "${HOME:-}" "${PWD:-.}"; do
        if [ -z "$dir" ] || [ ! -d "$dir" ] || [ ! -w "$dir" ]; then
            continue
        fi

        candidate=$(mktemp -d "$dir/axe.XXXXXX" 2>/dev/null) || {
            candidate="$dir/axe.$$"
            mkdir "$candidate" 2>/dev/null || continue
        }

        if ! printf '#!%s\nexit 0\n' "$interpreter" > "$candidate/axe" || ! chmod 700 "$candidate/axe"; then
            rm -rf -- "$candidate"
            continue
        fi

        if "$candidate/axe" 2>/dev/null; then
            if [ -n "$fallback" ]; then
                rm -rf -- "$fallback"
            fi
            WORK=$candidate
            return 0
        fi

        if [ -z "$fallback" ]; then
            fallback=$candidate
        else
            rm -rf -- "$candidate"
        fi
    done

    [ -n "$fallback" ] || return 1
    WORK=$fallback
}

if [ -n "$OUTPUT" ]; then
    # exec must not search PATH for a bare file name.
    case $OUTPUT in
        */*) ;;
        *) OUTPUT=./$OUTPUT ;;
    esac
    mkdir -p -- "$(dirname -- "$OUTPUT")" || exit 1
    FILE=$OUTPUT.part
else
    if ! make_workdir; then
        say 'no writable directory for the download'
        exit 1
    fi
    FILE=$WORK/axe.part
fi

sha256_of() {
    {
        if have sha256sum; then
            sha256sum "$1"
        elif have shasum; then
            shasum -a 256 "$1"
        elif have busybox; then
            busybox sha256sum "$1"
        elif have openssl; then
            openssl dgst -sha256 -r "$1"
        elif have python3; then
            python3 -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$1"
        elif have perl; then
            perl -MDigest::SHA -e 'print Digest::SHA->new(256)->addfile($ARGV[0])->hexdigest' "$1"
        fi
    } 2>/dev/null | {
        read -r sum _ && printf '%s' "$sum"
    }
}

# A size or digest mismatch rejects the download. Only a host without any
# SHA-256 tool runs the payload unverified, with a warning.
verify() {
    size=$(wc -c < "$FILE" | tr -d ' ')
    if [ "$size" != "$SIZE" ]; then
        say "size mismatch: got $size, expected $SIZE"
        return 1
    fi

    sum=$(sha256_of "$FILE")
    if [ -z "$sum" ]; then
        say 'warning: no SHA-256 tool found; running an unverified download'
        return 0
    fi

    if [ "$sum" != "$SHA256" ]; then
        say 'SHA-256 mismatch'
        return 1
    fi
}

# Every fetcher takes a pinned address and writes the response body to $FILE.
# Only curl speaks HTTPS (with the real host name for SNI); the others use
# plain HTTP, which the pinned size and digest make safe.
fetch_curl_https() {
    curl -fsS --connect-timeout 10 --resolve "$HOST:$HTTPS_PORT:$1" \
        -o "$FILE" "https://$HOST:$HTTPS_PORT$URL_PATH"
}

fetch_curl() {
    curl -fsS --connect-timeout 10 --resolve "$HOST:$HTTP_PORT:$1" \
        -o "$FILE" "http://$HOST:$HTTP_PORT$URL_PATH"
}

fetch_wget() {
    case $1 in
        *:*) url="http://[$1]:$HTTP_PORT$URL_PATH" ;;
        *) url="http://$1:$HTTP_PORT$URL_PATH" ;;
    esac

    if have wget; then
        wget -q -T 10 -O "$FILE" --header "Host: $HOST" "$url"
    else
        busybox wget -q -T 10 -O "$FILE" --header "Host: $HOST" "$url"
    fi
}

fetch_python() {
    if have python3; then
        python=python3
    else
        python=python
    fi

    "$python" - "$1" "$HTTP_PORT" "$HOST" "$URL_PATH" "$FILE" <<'EOF'
import socket
import sys

address, port, host, path, out = sys.argv[1:]
connection = socket.create_connection((address, int(port)), 10)
connection.sendall(("GET %s HTTP/1.0\r\nHost: %s\r\n\r\n" % (path, host)).encode())

chunks = []
while True:
    chunk = connection.recv(1 << 20)
    if not chunk:
        break
    chunks.append(chunk)

head, _, body = b"".join(chunks).partition(b"\r\n\r\n")
if head.split(b" ")[1:2] != [b"200"]:
    sys.exit(1)

with open(out, "wb") as file:
    file.write(body)
EOF
}

fetch_perl() {
    perl - "$1" "$HTTP_PORT" "$HOST" "$URL_PATH" "$FILE" <<'EOF'
use strict;
use IO::Socket::INET;

my ($address, $port, $host, $path, $out) = @ARGV;
my $class = eval { require IO::Socket::IP; 'IO::Socket::IP' } || 'IO::Socket::INET';
my $socket = $class->new(PeerAddr => $address, PeerPort => $port, Proto => 'tcp', Timeout => 10)
    or exit 1;
syswrite $socket, "GET $path HTTP/1.0\r\nHost: $host\r\n\r\n";

my $data = '';
while (sysread($socket, my $chunk, 1 << 20)) {
    $data .= $chunk;
}

my ($head, $body) = split /\r\n\r\n/, $data, 2;
exit 1 unless defined $body && $head =~ m{^HTTP/\S+ 200 };

open my $file, '>:raw', $out or exit 1;
print {$file} $body;
close $file or exit 1;
EOF
}

fetch_node() {
    node - "$1" "$HTTP_PORT" "$HOST" "$URL_PATH" "$FILE" <<'EOF'
const [address, port, host, path, out] = process.argv.slice(2);
const chunks = [];

const socket = require("net").connect({ host: address, port: Number(port) }, () => {
  socket.write(`GET ${path} HTTP/1.0\r\nHost: ${host}\r\n\r\n`);
});
socket.setTimeout(10000, () => socket.destroy(new Error("timeout")));
socket.on("data", (chunk) => chunks.push(chunk));
socket.on("error", () => process.exit(1));

socket.on("end", () => {
  const data = Buffer.concat(chunks);
  const split = data.indexOf("\r\n\r\n");
  if (split < 0 || !/^HTTP\/\S+ 200 /.test(data.subarray(0, split).toString("latin1"))) {
    process.exit(1);
  }
  require("fs").writeFileSync(out, data.subarray(split + 4));
});
EOF
}

fetch_bash() {
    bash -s "$1" "$HTTP_PORT" "$HOST" "$URL_PATH" "$FILE" <<'EOF'
exec 3<>"/dev/tcp/$1/$2" || exit 1
printf 'GET %s HTTP/1.0\r\nHost: %s\r\n\r\n' "$4" "$3" >&3

IFS= read -r -t 10 status <&3 || exit 1
case $status in
    "HTTP/"*" 200 "*) ;;
    *) exit 1 ;;
esac

while IFS= read -r -t 10 line <&3; do
    [ "$line" = $'\r' ] && break
done

cat <&3 > "$5"
EOF
}

fetchers=
if have curl; then
    fetchers="$fetchers fetch_curl_https fetch_curl"
fi
if have wget || have busybox; then
    fetchers="$fetchers fetch_wget"
fi
if have python3 || have python; then
    fetchers="$fetchers fetch_python"
fi
if have perl; then
    fetchers="$fetchers fetch_perl"
fi
if have node; then
    fetchers="$fetchers fetch_node"
fi
if have bash; then
    fetchers="$fetchers fetch_bash"
fi

if [ -z "$fetchers" ]; then
    say 'no download tool found (curl, wget, busybox, python, perl, node, bash)'
    exit 1
fi

for fetcher in $fetchers; do
    for address in $ADDRESSES; do
        rm -f -- "$FILE"
        "$fetcher" "$address" 2>/dev/null || continue
        verify || continue

        chmod 700 "$FILE" || exit 1
        mv -f -- "$FILE" "${FILE%.part}" || exit 1
        FILE=${FILE%.part}

        if [ "$EXECUTE" = 0 ]; then
            # Keep the download and report where it is.
            WORK=
            printf '%s\n' "$FILE"
            exit 0
        fi

        exec "$FILE" "$@"
    done
done

rm -f -- "$FILE"
say "download failed for $TARGET (tried:$fetchers)"
exit 1
