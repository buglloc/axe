#!/usr/bin/env node
// AXE bootstrap, generated by bootstrap/generate.py: download the static axe
// release from pinned addresses, check its size and SHA-256, and run it.
//
// usage: node - [--output PATH] [--no-exec] [--] [AXE ARG ...]
"use strict";

const childProcess = require("child_process");
const crypto = require("crypto");
const fs = require("fs");
const net = require("net");
const os = require("os");
const path = require("path");
const tls = require("tls");

const DATA = @@DATA@@;
const MACHINES = { x64: "x86_64-linux", arm64: "aarch64-linux" };
const TIMEOUT_MS = 10000;
const USAGE = "usage: node - [--output PATH] [--no-exec] [--] [AXE ARG ...]";

function selectTarget() {
  if (process.platform !== "linux") {
    throw new Error(`unsupported operating system: ${process.platform}`);
  }

  const name = process.env.AXE_BOOTSTRAP_TARGET || process.arch;
  const target = MACHINES[name] || name;
  if (!DATA.targets[target]) {
    throw new Error(`unsupported architecture: ${name}`);
  }
  return DATA.targets[target];
}

function parseArguments(argv) {
  let output = null;
  let execute = true;
  let index = 0;

  for (; index < argv.length; index += 1) {
    const item = argv[index];
    if (item === "--output") {
      if (index + 1 >= argv.length) throw new Error("--output requires a path");
      output = argv[index + 1];
      index += 1;
    } else if (item === "--no-exec") {
      execute = false;
    } else if (item === "-h" || item === "--help") {
      console.error(USAGE);
      process.exit(0);
    } else if (item === "--") {
      index += 1;
      break;
    } else {
      break;
    }
  }

  const rest = argv.slice(index);
  return { output, execute, args: rest.length ? rest : [...DATA.default_args] };
}

// Resolve with the response body from one pinned address.
function fetch(manifest, address, secure) {
  return new Promise((resolve, reject) => {
    const port = manifest.ports[secure ? "https" : "http"];
    const request = `GET ${manifest.path} HTTP/1.0\r\nHost: ${manifest.host}\r\n\r\n`;
    const chunks = [];

    const socket = secure
      ? tls.connect({ host: address, port, servername: manifest.host }, () => socket.write(request))
      : net.connect({ host: address, port }, () => socket.write(request));

    socket.setTimeout(TIMEOUT_MS, () => socket.destroy(new Error("timed out")));
    socket.on("error", reject);
    socket.on("data", (chunk) => chunks.push(chunk));

    socket.on("end", () => {
      const data = Buffer.concat(chunks);
      const split = data.indexOf("\r\n\r\n");
      const status = split < 0 ? "" : data.subarray(0, split).toString("latin1").split("\r\n")[0];
      if (!/^HTTP\/\S+ 200 /.test(status)) {
        reject(new Error(status || "invalid response"));
        return;
      }
      resolve(data.subarray(split + 4));
    });
  });
}

// Try HTTPS, then plain HTTP, on every address; return verified bytes.
async function download(manifest) {
  const failures = [];

  for (const secure of [true, false]) {
    for (const address of manifest.addresses) {
      const label = `${secure ? "https" : "http"} ${address}`;
      let body;
      try {
        body = await fetch(manifest, address, secure);
      } catch (error) {
        failures.push(`${label}: ${error.message}`);
        continue;
      }

      if (body.length !== manifest.size) {
        failures.push(`${label}: got ${body.length} bytes, expected ${manifest.size}`);
      } else if (crypto.createHash("sha256").update(body).digest("hex") !== manifest.sha256) {
        failures.push(`${label}: SHA-256 mismatch`);
      } else {
        return body;
      }
    }
  }

  throw new Error(`download failed: ${failures.join("; ")}`);
}

function writeExecutable(file, payload) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const partial = `${file}.part`;
  fs.writeFileSync(partial, payload, { mode: 0o700 });
  fs.renameSync(partial, file);
}

// Node cannot exec in place: run the payload as a child that owns the
// terminal, and pass its exit status through.
function run(file, args) {
  for (const signal of ["SIGINT", "SIGQUIT"]) process.on(signal, () => {});

  const result = childProcess.spawnSync(file, args, { argv0: "axe", stdio: "inherit" });
  if (result.error) throw result.error;
  if (result.signal) return 128 + os.constants.signals[result.signal];
  return result.status;
}

// Run from the first temporary directory that allows exec, then remove it.
function runTemporary(payload, args) {
  const candidates = [
    process.env.AXE_BOOTSTRAP_DIR,
    process.env.TMPDIR,
    "/dev/shm",
    "/tmp",
    "/var/tmp",
    process.env.HOME,
    process.cwd(),
  ];

  for (const directory of candidates.filter(Boolean)) {
    let work;
    try {
      work = fs.mkdtempSync(path.join(directory, "axe."));
    } catch (_) {
      continue;
    }

    const file = path.join(work, "axe");
    try {
      writeExecutable(file, payload);
      return run(file, args);
    } catch (error) {
      // EACCES means a noexec mount: try the next directory.
      if (error.code !== "EACCES") throw error;
    } finally {
      fs.rmSync(work, { recursive: true, force: true });
    }
  }

  throw new Error("cannot execute the download from any temporary directory");
}

async function main(argv) {
  const manifest = selectTarget();
  const options = parseArguments(argv);
  const payload = await download(manifest);

  if (options.output !== null) {
    writeExecutable(options.output, payload);
    return options.execute ? run(path.resolve(options.output), options.args) : 0;
  }
  if (!options.execute) {
    throw new Error("--no-exec requires --output");
  }
  return runTemporary(payload, options.args);
}

main(process.argv.slice(2)).then(
  (status) => process.exit(status),
  (error) => {
    console.error(`axe bootstrap: ${error.message || error}`);
    process.exit(1);
  },
);
